{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Aqua Theme",
    "settings": {
        "color": {
            "palette": [
                {
                    "color": "#007cba",
                    "name": "Aqua",
                    "slug": "aqua"
                },
                {
                    "color": "#ffffff",
                    "name": "White",
                    "slug": "white"
                },
                {
                    "color": "#1a1a1a",
                    "name": "Dark",
                    "slug": "dark"
                },
                {
                    "color": "#f8f9fa",
                    "name": "Light Gray",
                    "slug": "light-gray"
                },
                {
                    "color": "#6c757d",
                    "name": "Gray",
                    "slug": "gray"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "Inter, sans-serif",
                    "name": "Inter",
                    "slug": "inter"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "1.25rem",
                    "slug": "large"
                },
                {
                    "name": "Extra Large",
                    "size": "1.5rem",
                    "slug": "x-large"
                },
                {
                    "name": "Huge",
                    "size": "2rem",
                    "slug": "huge"
                }
            ]
        },
        "spacing": {
            "spacingScale": {
                "steps": 8,
                "mediumStep": 1.5,
                "unit": "rem"
            },
            "spacingSizes": [
                {
                    "name": "Small",
                    "size": "0.5rem",
                    "slug": "s"
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "m"
                },
                {
                    "name": "Large",
                    "size": "2rem",
                    "slug": "l"
                },
                {
                    "name": "Extra Large",
                    "size": "4rem",
                    "slug": "xl"
                }
            ]
        },
        "border": {
            "radius": true
        },
        "shadow": {
            "presets": [
                {
                    "name": "Natural",
                    "slug": "natural",
                    "shadow": "0 4px 20px rgba(0, 0, 0, 0.08)"
                },
                {
                    "name": "Deep",
                    "slug": "deep",
                    "shadow": "0 8px 30px rgba(0, 0, 0, 0.12)"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--white)",
            "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--inter)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--m)"
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}
